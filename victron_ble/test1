#include <Arduino.h>
#include <BLEDevice.h>
#include <BLEUtils.h>
#include <BLEScan.h>
#include <BLEAdvertisedDevice.h>

static const char* TARGET_MAC = "c7:99:4b:5e:37:f5";

class MyAdvertisedDeviceCallbacks : public BLEAdvertisedDeviceCallbacks {
  void onResult(BLEAdvertisedDevice dev) override {

    if (dev.getAddress().toString() == TARGET_MAC) {

      Serial.println("----- SMARTSHUNT ADVERTISEMENT -----");

      Serial.printf("MAC: %s\n", dev.getAddress().toString().c_str());

      if (dev.haveName()) {
        Serial.printf("Name: %s\n", dev.getName().c_str());
      } else {
        Serial.println("Name: (none)");
      }

      Serial.printf("RSSI: %d dBm\n", dev.getRSSI());

      if (dev.haveManufacturerData()) {
        String md = dev.getManufacturerData();
        Serial.print("Manufacturer Data: ");
        for (size_t i = 0; i < md.length(); i++) {
          Serial.printf("%02X ", (uint8_t)md[i]);
        }
        Serial.println();
      } else {
        Serial.println("Manufacturer Data: (none)");
      }

      Serial.println("------------------------------------\n");
    }
  }
};


void setup() {
  Serial.begin(115200);
  delay(200);

  Serial.println("SmartShunt Advertisement Reader Starting...");

  BLEDevice::init("");

  BLEScan* scan = BLEDevice::getScan();
  scan->setAdvertisedDeviceCallbacks(new MyAdvertisedDeviceCallbacks());
  scan->setActiveScan(true);
  scan->setInterval(100);
  scan->setWindow(99);

  // Continuous scan (0 = forever)
  scan->start(0, false);
}

void loop() {
  delay(1000);
}
